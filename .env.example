DATABASE_URL=postgresql://eliza:eliza_local@127.0.0.1:54329/eliza
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Production: HTTPS origin without trailing slash and private database credentials.
# HOST=0.0.0.0
# SERVE_WEB=true
# SETUP_TOKEN=<random secret of at least 32 characters; remove after store setup>
# TRUST_PROXY=1
# Only set TRUST_PROXY behind a controlled single-hop ingress such as Railway.

# Optional Open Food Facts identification and testing
# OFF_CONTACT=admin@example.com
# OFF_ENV=staging

# Optional purchase document assistant (server only; never use a VITE_ prefix)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional override for Eliza AI function calling
# OPENAI_AGENT_MODEL=gpt-4o-mini
# Optional override for universal scanned documents (Responses API)
# OPENAI_DOCUMENT_MODEL=gpt-4o-mini
